# Пример файла переменных окружения для backend
# Скопируйте этот файл в .env и заполните актуальными значениями

# Драйвер базы данных (postgres для PostgreSQL)
DATABASE_DRIVER="postgres"

# Имя базы данных
DATABASE_URL="films"

# Имя пользователя базы данных
DATABASE_USERNAME="postgres"

# Пароль пользователя базы данных
DATABASE_PASSWORD="postgres"

# Хост базы данных
DATABASE_HOST="localhost"

# Порт базы данных
DATABASE_PORT="5432"

# Уровень отладки
DEBUG=*

# Режим окружения (development, production)
NODE_ENV="development"
