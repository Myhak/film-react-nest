# Пример файла переменных окружения для backend
# Скопируйте этот файл в .env и заполните актуальными значениями

# Драйвер базы данных (postgres для PostgreSQL)
DATABASE_DRIVER="postgres"

# Строка подключения к PostgreSQL
# Формат: postgres://username:password@host:port/database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/films"

# Имя пользователя базы данных
DATABASE_USERNAME="postgres"

# Пароль пользователя базы данных
DATABASE_PASSWORD="postgres"

# Уровень отладки
DEBUG=*
