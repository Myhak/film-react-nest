# Пример файла переменных окружения для frontend
# Скопируйте этот файл в .env и заполните актуальными значениями

# URL API бэкенда
# Для локальной разработки: http://localhost:3000/api/afisha
# Для продакшена: https://your-domain.com/api/afisha
VITE_API_URL=http://localhost:3000/api/afisha

# URL CDN для статических файлов (афиши фильмов)
# Для локальной разработки: http://localhost:3000/content/afisha
# Для продакшена: https://your-domain.com/content/afisha
VITE_CDN_URL=http://localhost:3000/content/afisha
